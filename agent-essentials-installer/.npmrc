# NPM Registry configuration for @anedezorchestrator scoped packages
# For publishing to the public NPM registry with your scoped package

# Authenticate with NPM (required before publishing)
# Run: npm login --scope=@anedezorchestrator --registry=https://registry.npmjs.org

# Set the registry for this scope
@anedezorchestrator:registry=https://registry.npmjs.org

# Enable provenance (optional, recommended for security)
# This creates an attestation for your packages
npm_config_provenance=true

# Set access level to public (required for scoped packages)
# This is overridden by --access=public flag during publish
access=public
